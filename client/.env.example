# Express API origin used by RTK Query (the server defaults to port 3001).
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/

# HTTPS origin for profile pictures and task attachments.
# Must be a valid HTTPS URL and its hostname must be permitted by Next.js image config.
NEXT_PUBLIC_IMAGE_BASE_URL=https://images.example.com

# Amazon Cognito browser configuration. Replace both placeholders with values
# from the Cognito User Pool used by this environment.
NEXT_PUBLIC_COGNITO_USER_POOL_ID=us-east-1_EXAMPLE
NEXT_PUBLIC_COGNITO_USER_POOL_CLIENT_ID=example-app-client-id
